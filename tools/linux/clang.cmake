# The release ships this compiler and the Steam Runtime sysroot. No system SDK is needed.
if(NOT DW5E_LINUX_TOOLCHAIN_ROOT AND DEFINED ENV{DW5E_LINUX_TOOLCHAIN_ROOT})
    set(DW5E_LINUX_TOOLCHAIN_ROOT "$ENV{DW5E_LINUX_TOOLCHAIN_ROOT}" CACHE PATH "Bundled Linux SDK")
endif()
if(NOT DW5E_LINUX_TOOLCHAIN_ROOT)
    message(FATAL_ERROR "DW5E_LINUX_TOOLCHAIN_ROOT must point at the bundled tools/clang folder")
endif()
# CMake 3.25's whole-project LTO probes do not copy custom cache variables.
set(ENV{DW5E_LINUX_TOOLCHAIN_ROOT} "${DW5E_LINUX_TOOLCHAIN_ROOT}")
set(CMAKE_C_COMPILER "${DW5E_LINUX_TOOLCHAIN_ROOT}/bin/clang")
set(CMAKE_CXX_COMPILER "${DW5E_LINUX_TOOLCHAIN_ROOT}/bin/clang++")
set(CMAKE_AR "${DW5E_LINUX_TOOLCHAIN_ROOT}/bin/llvm-ar")
set(CMAKE_RANLIB "${DW5E_LINUX_TOOLCHAIN_ROOT}/bin/llvm-ranlib")
if(EXISTS "${DW5E_LINUX_TOOLCHAIN_ROOT}/sysroot")
    set(CMAKE_SYSROOT "${DW5E_LINUX_TOOLCHAIN_ROOT}/sysroot")
    set(CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
    set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
    set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
    set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
endif()
set(CMAKE_C_FLAGS_INIT "-march=x86-64-v2")
set(CMAKE_CXX_FLAGS_INIT "-march=x86-64-v2")
if(EXISTS "${DW5E_LINUX_TOOLCHAIN_ROOT}/include/c++")
    string(APPEND CMAKE_CXX_FLAGS_INIT " -stdlib=libc++")
    set(CMAKE_CXX_STANDARD_LIBRARIES_INIT "-lc++abi")
endif()
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fuse-ld=lld")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-fuse-ld=lld")
if(EXISTS "${DW5E_LINUX_TOOLCHAIN_ROOT}/lib")
    string(APPEND CMAKE_EXE_LINKER_FLAGS_INIT " -L${DW5E_LINUX_TOOLCHAIN_ROOT}/lib -Wl,-rpath,'$ORIGIN'")
    string(APPEND CMAKE_SHARED_LINKER_FLAGS_INIT " -L${DW5E_LINUX_TOOLCHAIN_ROOT}/lib -Wl,-rpath,'$ORIGIN'")
endif()
list(APPEND CMAKE_TRY_COMPILE_PLATFORM_VARIABLES DW5E_LINUX_TOOLCHAIN_ROOT)
