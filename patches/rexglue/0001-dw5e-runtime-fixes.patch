-static void InvalidFunctionTrap(PPCContext& ctx, uint8_t* /*base*/) {
+static void InvalidFunctionTrap(PPCContext& ctx, uint8_t* base) {
+  // dw5e-port: log the caller and a guest stack walk before dying.
+  REXLOG_ERROR("Invalid call target 0x{:08X}: lr=0x{:08X} ctr=0x{:08X} r1=0x{:08X} r3=0x{:08X} "
+               "r4=0x{:08X} r12=0x{:08X}",
+               ctx.last_indirect_target, static_cast<uint32_t>(ctx.lr), ctx.ctr.u32, ctx.r1.u32,
+               ctx.r3.u32, ctx.r4.u32, ctx.r12.u32);
+  if (base) {
+    // Fault-free read: process_vm_readv returns an error on unmapped memory instead of
+    // raising a signal (a plain load past the stack top loops in the guest AV handler).
+    auto load = [base](uint32_t addr, uint32_t& out) -> bool {
+#if defined(__linux__)
+      uint32_t raw = 0;
+      iovec local{&raw, sizeof(raw)};
+      iovec remote{base + addr, sizeof(raw)};
+      if (process_vm_readv(getpid(), &local, 1, &remote, 1, 0) != sizeof(raw)) return false;
+      out = __builtin_bswap32(raw);
+      return true;
+#else
+      (void)addr; (void)out;
+      return false;
+#endif
+    };
+    // Object/vtable at a virtual call site: lwz r11,0(r31) ; lwz r10,N(r11) ; mtctr ; bctrl
+    REXLOG_ERROR("  r11(vtable?)=0x{:08X} r31(this?)=0x{:08X}", ctx.r11.u32, ctx.r31.u32);
+    for (uint32_t obj : {ctx.r31.u32, ctx.r3.u32}) {
+      uint32_t vt = 0;
+      if (!obj || !load(obj, vt)) continue;
+      std::string line;
+      for (uint32_t i = 0; i < 20; ++i) {
+        uint32_t e = 0;
+        line += load(vt + i * 4, e) ? fmt::format(" {:08X}", e) : std::string(" ????????");
+      }
+      REXLOG_ERROR("  obj 0x{:08X} vtable 0x{:08X}:{}", obj, vt, line);
+    }
+    uint32_t sp = ctx.r1.u32;
+    for (int depth = 0; depth < 16 && sp >= 0x40000000 && sp < 0x80000000; ++depth) {
+      uint32_t back_chain = 0, saved_lr = 0;
+      if (!load(sp, back_chain)) break;
+      if (back_chain <= sp || back_chain >= 0x80000000) break;
+      if (!load(back_chain - 8, saved_lr)) break;  // callers do "mflr r12; stw r12,-8(r1)"
+      REXLOG_ERROR("  frame {:2}: sp=0x{:08X} return=0x{:08X}", depth, back_chain, saved_lr);
+      sp = back_chain;
+    }
+  }
   REX_FATAL("Call to invalid or unregistered function at guest address 0x{:08X}",
             ctx.last_indirect_target);
 }
diff --git a/src/system/xevent.cpp b/src/system/xevent.cpp
index c24fbd1..c4a61f9 100644
--- a/src/system/xevent.cpp
+++ b/src/system/xevent.cpp
@@ -22,7 +22,14 @@ XEvent::~XEvent() = default;
 void XEvent::Initialize(bool manual_reset, bool initial_state) {
   assert_false(event_);
 
+  manual_reset_ = manual_reset;
   this->CreateNative<X_KEVENT>();
+  // dw5e-port: ported from xenia-canary dcf2994 (2026-09-13): keep the guest header truthful.
+  // Don't touch wait_list: SetNativePointer stashes the handle there.
+  auto* kevent = guest_object<X_KEVENT>();
+  kevent->header.type = manual_reset ? 0x00 : 0x01;
+  kevent->header.signal_state = initial_state ? 1 : 0;
+  host_signaled_ = initial_state;
 
   if (manual_reset) {
     event_ = rex::thread::Event::CreateManualResetEvent(initial_state);
@@ -48,12 +55,15 @@ void XEvent::InitializeNative(void* native_ptr, X_DISPATCH_HEADER* header) {
   }
 
   bool initial_state = header->signal_state ? true : false;
+  host_signaled_ = initial_state;
   if (manual_reset_) {
     event_ = rex::thread::Event::CreateManualResetEvent(initial_state);
   } else {
     event_ = rex::thread::Event::CreateAutoResetEvent(initial_state);
   }
   assert_not_null(event_);
+  // Track the guest header so Set/Reset/SyncFromGuest can reach it.
+  SetNativePointer(memory()->HostToGuestVirtual(native_ptr), true);
 }
 
 void XEvent::Query(uint32_t* out_type, uint32_t* out_state) {
@@ -74,20 +84,59 @@ void XEvent::Query(uint32_t* out_type, uint32_t* out_state) {
 }
 
 int32_t XEvent::Set(uint32_t priority_increment, bool wait) {
+  std::lock_guard<std::mutex> lock(state_lock_);
+  guest_object<X_KEVENT>()->header.signal_state = 1;
+  host_signaled_ = true;
   event_->Set();
   return 1;
 }
 
 int32_t XEvent::Pulse(uint32_t priority_increment, bool wait) {
+  std::lock_guard<std::mutex> lock(state_lock_);
+  auto* kevent = guest_object<X_KEVENT>();
+  // KePulseEvent returns the pre-pulse signal state.
+  const int32_t old_signal_state = kevent->header.signal_state;
   event_->Pulse();
-  return 1;
+  // Pulse leaves the event reset after releasing waiters.
+  kevent->header.signal_state = 0;
+  host_signaled_ = false;
+  return old_signal_state;
 }
 
 int32_t XEvent::Reset() {
+  std::lock_guard<std::mutex> lock(state_lock_);
+  guest_object<X_KEVENT>()->header.signal_state = 0;
+  host_signaled_ = false;
   event_->Reset();
   return 1;
 }
 
+void XEvent::WaitCallback() {
+  // Auto-reset events clear on a successful wait; manual-reset events stay set.
+  if (!manual_reset_) {
+    std::lock_guard<std::mutex> lock(state_lock_);
+    guest_object<X_KEVENT>()->header.signal_state = 0;
+    host_signaled_ = false;
+  }
+}
+
+void XEvent::SyncFromGuest() {
+  if (!guest_object()) {
+    return;
+  }
+  std::lock_guard<std::mutex> lock(state_lock_);
+  bool guest_signaled = guest_object<X_KEVENT>()->header.signal_state ? true : false;
+  if (guest_signaled == host_signaled_) {
+    return;
+  }
+  host_signaled_ = guest_signaled;
+  if (guest_signaled) {
+    event_->Set();
+  } else {
+    event_->Reset();
+  }
+}
+
 void XEvent::Clear() {
   event_->Reset();
 }
