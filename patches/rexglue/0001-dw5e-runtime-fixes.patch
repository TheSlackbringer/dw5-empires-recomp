-static void InvalidFunctionTrap(PPCContext& ctx, uint8_t* /*base*/) {
+static void InvalidFunctionTrap(PPCContext& ctx, uint8_t* base) {
+  // dw5e-port: log the caller and a guest stack walk before dying.
+  REXLOG_ERROR("Invalid call target 0x{:08X}: lr=0x{:08X} ctr=0x{:08X} r1=0x{:08X} r3=0x{:08X} "
+               "r4=0x{:08X} r12=0x{:08X}",
+               ctx.last_indirect_target, static_cast<uint32_t>(ctx.lr), ctx.ctr.u32, ctx.r1.u32,
+               ctx.r3.u32, ctx.r4.u32, ctx.r12.u32);
+  if (base) {
+    // Fault-free read: process_vm_readv returns an error on unmapped memory instead of
+    // raising a signal (a plain load past the stack top loops in the guest AV handler).
+    auto load = [base](uint32_t addr, uint32_t& out) -> bool {
+#if defined(__linux__)
+      uint32_t raw = 0;
+      iovec local{&raw, sizeof(raw)};
+      iovec remote{base + addr, sizeof(raw)};
+      if (process_vm_readv(getpid(), &local, 1, &remote, 1, 0) != sizeof(raw)) return false;
+      out = __builtin_bswap32(raw);
+      return true;
+#else
+      (void)addr; (void)out;
+      return false;
+#endif
+    };
+    // Object/vtable at a virtual call site: lwz r11,0(r31) ; lwz r10,N(r11) ; mtctr ; bctrl
+    REXLOG_ERROR("  r11(vtable?)=0x{:08X} r31(this?)=0x{:08X}", ctx.r11.u32, ctx.r31.u32);
+    for (uint32_t obj : {ctx.r31.u32, ctx.r3.u32}) {
+      uint32_t vt = 0;
+      if (!obj || !load(obj, vt)) continue;
+      std::string line;
+      for (uint32_t i = 0; i < 20; ++i) {
+        uint32_t e = 0;
+        line += load(vt + i * 4, e) ? fmt::format(" {:08X}", e) : std::string(" ????????");
+      }
+      REXLOG_ERROR("  obj 0x{:08X} vtable 0x{:08X}:{}", obj, vt, line);
+    }
+    uint32_t sp = ctx.r1.u32;
+    for (int depth = 0; depth < 16 && sp >= 0x40000000 && sp < 0x80000000; ++depth) {
+      uint32_t back_chain = 0, saved_lr = 0;
+      if (!load(sp, back_chain)) break;
+      if (back_chain <= sp || back_chain >= 0x80000000) break;
+      if (!load(back_chain - 8, saved_lr)) break;  // callers do "mflr r12; stw r12,-8(r1)"
+      REXLOG_ERROR("  frame {:2}: sp=0x{:08X} return=0x{:08X}", depth, back_chain, saved_lr);
+      sp = back_chain;
+    }
+  }
   REX_FATAL("Call to invalid or unregistered function at guest address 0x{:08X}",
             ctx.last_indirect_target);
 }
diff --git a/src/system/xevent.cpp b/src/system/xevent.cpp
